# Local MySQL 8. Create an empty database first:  CREATE DATABASE lms;
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/lms"

PORT=3333
CORS_ORIGIN="http://localhost:4200"

JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_TTL="15m"
